{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2017",
    "noResolve": false,
    "noImplicitAny": false,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "strictNullChecks": true,
    "declaration": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "rootDir": "./src",
    "outDir": "./lib",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "types": ["jest"]
  },
  "include": ["src/**/*.d.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "**/__tests__/*"]
}
