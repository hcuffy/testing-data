{
  "name": "testing-data",
  "version": "1.2.1",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "author": "Henry Cuffy",
  "description": "Randomly generate vehicle and user data for testing purposes",
  "homepage": "https://github.com/hcuffy/testing-data",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/hcuffy/testing-data"
  },
  "scripts": {
    "build": "tsc",
    "fix": "pnpm eslint src --fix",
    "lint": "eslint src/**/*.ts",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm test && pnpm lint",
    "release": "bash scripts/release.sh",
    "release:patch": "npm version patch && pnpm release",
    "release:minor": "npm version minor && pnpm release",
    "release:major": "npm version major && pnpm release",
    "test": "jest",
    "coverage": "pnpm test --coverage"
  },
  "dependencies": {
    "chance": "1.1.13",
    "dayjs": "1.11.23",
    "lodash": "4.18.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.25",
    "@types/node": "25.0.6",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "10.11.0",
    "eslint-plugin-jest": "29.16.6",
    "globals": "17.12.0",
    "jest": "30.5.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/utils": "8.65.0",
      "minimatch@>=9.0.0 <9.0.9": "9.0.9",
      "picomatch@>=2.0.0 <2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "brace-expansion@>=1.0.0 <1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "browserslist@<=4.28.6": "4.28.7",
      "@humanfs/node@<0.16.8": "0.16.8",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "2.11.0",
      "@babel/core@<=7.29.0": "7.29.7",
      "flatted@<3.4.2": "3.4.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  },
  "watch": {
    "pretest": {
      "patterns": "src",
      "extensions": "ts"
    },
    "start": {
      "patterns": "src",
      "extensions": "ts"
    }
  },
  "files": [
    "/lib"
  ],
  "keywords": [
    "typescript",
    "javascript",
    "testing",
    "vin",
    "vin-generator",
    "testing",
    "testing-data",
    "user",
    "people",
    "user-data"
  ]
}
