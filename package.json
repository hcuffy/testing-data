{
  "name": "testing-data",
  "version": "1.1.3",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "author": "Henry Cuffy",
  "description": "Randomly generate vehicle and user data for testing purposes",
  "homepage": "https://github.com/hcuffy/testing-data",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/hcuffy/testing-data"
  },
  "scripts": {
    "build": "tsc",
    "fix": "yarn eslint src --fix",
    "lint": "eslint src/**/*.ts",
    "prepare": "yarn build",
    "prepublishOnly": "yarn test && yarn lint",
    "test": "jest",
    "coverage": "yarn test --coverage"
  },
  "dependencies": {
    "chance": "^1.1.12",
    "lodash": "^4.17.21",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.12.0",
    "@types/jest": "^29.5.13",
    "@types/lodash": "^4.17.10",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.12.0",
    "eslint-plugin-jest": "^28.8.3",
    "globals": "^15.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "watch": {
    "pretest": {
      "patterns": "src",
      "extensions": "ts"
    },
    "start": {
      "patterns": "src",
      "extensions": "ts"
    }
  },
  "files": [
    "/lib"
  ],
  "keywords": [
    "typescript",
    "javascript",
    "testing",
    "vin",
    "vin-generator",
    "testing",
    "testing-data",
    "user",
    "people",
    "user-data"
  ]
}
