{
  "name": "testing-data",
  "version": "1.2.0",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "author": "Henry Cuffy",
  "description": "Randomly generate vehicle and user data for testing purposes",
  "homepage": "https://github.com/hcuffy/testing-data",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/hcuffy/testing-data"
  },
  "scripts": {
    "build": "tsc",
    "fix": "pnpm eslint src --fix",
    "lint": "eslint src/**/*.ts",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm test && pnpm lint",
    "release": "bash scripts/release.sh",
    "release:patch": "npm version patch && pnpm release",
    "release:minor": "npm version minor && pnpm release",
    "release:major": "npm version major && pnpm release",
    "test": "jest",
    "coverage": "pnpm test --coverage"
  },
  "dependencies": {
    "chance": "1.1.13",
    "dayjs": "1.11.21",
    "lodash": "4.18.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.24",
    "@types/node": "25.0.6",
    "@typescript-eslint/eslint-plugin": "8.52.0",
    "@typescript-eslint/parser": "8.52.0",
    "eslint": "10.8.0",
    "eslint-plugin-jest": "29.15.2",
    "globals": "17.6.0",
    "jest": "30.4.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "watch": {
    "pretest": {
      "patterns": "src",
      "extensions": "ts"
    },
    "start": {
      "patterns": "src",
      "extensions": "ts"
    }
  },
  "files": [
    "/lib"
  ],
  "keywords": [
    "typescript",
    "javascript",
    "testing",
    "vin",
    "vin-generator",
    "testing",
    "testing-data",
    "user",
    "people",
    "user-data"
  ]
}
